<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<AssemblyName>DubheTech</AssemblyName>
		<RootNamespace>DubheTech</RootNamespace>
		<Version>0.1.0</Version>
		<!-- 编译产物直接输出到 Mod 标准的 Assemblies 目录 -->
		<OutputPath>..\..\Assemblies\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<Deterministic>true</Deterministic>
		<!-- 程序集由游戏自身宿主加载，不产生 .deps.json，避免打包进多余文件 -->
		<GenerateDependencyFile>false</GenerateDependencyFile>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugType>none</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<!-- RimWorld 1.7 引用程序集（仅编译期签名引用，不复制游戏文件） -->
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4979-alpha" />
		<!-- Harmony 运行时由游戏内的 Harmony Mod 提供，此处仅编译期引用；版本与游戏实际加载的库保持一致 -->
		<PackageReference Include="Lib.Harmony" Version="3.0.0-rc.3" ExcludeAssets="runtime" />
	</ItemGroup>

</Project>
