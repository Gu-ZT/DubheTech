<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingDef ParentName="BuildingBase">
		<defName>DubheTech_TransmissionPole</defName>
		<label>transmission pole</label>
		<description>A pylon built around a magneto core. It links wirelessly with other transmission poles within 24 cells, carrying power across the gap. Devices within 6 cells of a pole connect to it directly, no conduits needed.</description>
		<graphicData>
			<texPath>Things/Building/DubheTech/transmission_pole</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1,2)</drawSize>
			<!-- 贴图底部与放置格对齐：上移超出一格部分的一半 -->
			<drawOffset>(0,0,0.5)</drawOffset>
		</graphicData>
		<costList>
			<DubheTech_MagnetoCore>1</DubheTech_MagnetoCore>
			<Steel>8</Steel>
		</costList>
		<!-- 高层建筑高度层：杆体贴图向上伸出数格，需盖住同层树木，与原版宽幅护盾投影塔一致 -->
		<altitudeLayer>BuildingOnTop</altitudeLayer>
		<designationCategory>Power</designationCategory>
		<researchPrerequisites>
			<li>DubheTech_Base</li>
		</researchPrerequisites>
		<statBases>
			<WorkToBuild>300</WorkToBuild>
			<MaxHitPoints>150</MaxHitPoints>
			<Flammability>0</Flammability>
		</statBases>
		<size>(1,1)</size>
		<passability>PassThroughOnly</passability>
		<blockLight>false</blockLight>
		<comps>
			<li Class="DubheTech.Comps.CompProperties_WirelessTransmitter">
				<compClass>DubheTech.Comps.CompWirelessTransmitter</compClass>
				<transmitsPower>true</transmitsPower>
				<radius>24</radius>
				<wireConnectHeight>1.3</wireConnectHeight>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="BuildingBase">
		<defName>DubheTech_RemoteTransmissionPole</defName>
		<label>remote transmission pole</label>
		<description>A tall pylon built around paired magneto cores. It links wirelessly with other transmission poles within 48 cells, carrying power across the gap. Devices within 6 cells of a pole connect to it directly, no conduits needed.</description>
		<graphicData>
			<texPath>Things/Building/DubheTech/remote_transmission_pole</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1,3)</drawSize>
			<!-- 贴图底部与放置格对齐：上移超出一格部分的一半 -->
			<drawOffset>(0,0,1)</drawOffset>
		</graphicData>
		<costList>
			<DubheTech_MagnetoCore>2</DubheTech_MagnetoCore>
			<Steel>24</Steel>
		</costList>
		<!-- 高层建筑高度层：杆体贴图向上伸出数格，需盖住同层树木，与原版宽幅护盾投影塔一致 -->
		<altitudeLayer>BuildingOnTop</altitudeLayer>
		<designationCategory>Power</designationCategory>
		<researchPrerequisites>
			<li>DubheTech_Base</li>
		</researchPrerequisites>
		<statBases>
			<WorkToBuild>600</WorkToBuild>
			<MaxHitPoints>200</MaxHitPoints>
			<Flammability>0</Flammability>
		</statBases>
		<size>(1,1)</size>
		<passability>PassThroughOnly</passability>
		<blockLight>false</blockLight>
		<comps>
			<li Class="DubheTech.Comps.CompProperties_WirelessTransmitter">
				<compClass>DubheTech.Comps.CompWirelessTransmitter</compClass>
				<transmitsPower>true</transmitsPower>
				<radius>48</radius>
				<wireConnectHeight>1.9</wireConnectHeight>
			</li>
		</comps>
	</ThingDef>

</Defs>
