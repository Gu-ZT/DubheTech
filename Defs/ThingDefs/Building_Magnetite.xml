<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingDef ParentName="RockBase">
		<defName>DubheTech_MineableMagnetite</defName>
		<label>magnetite ore</label>
		<description>A naturally magnetic iron ore. Mine it to obtain magnets.</description>
		<!-- 与原版矿石一致：共用 RockFlecked 图集并着色，链接样式从 RockBase 继承 -->
		<graphicData>
			<texPath>Things/Building/Linked/RockFlecked_Atlas</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<color>(85,82,88)</color>
			<colorTwo>(110,115,130)</colorTwo>
		</graphicData>
		<statBases>
			<MaxHitPoints>1000</MaxHitPoints>
		</statBases>
		<building>
			<mineableThing>DubheTech_Magnet</mineableThing>
			<mineableYield>25</mineableYield>
			<isResourceRock>true</isResourceRock>
			<mineableScatterCommonality>0.5</mineableScatterCommonality>
			<mineableScatterLumpSizeRange>4~8</mineableScatterLumpSizeRange>
			<claimable>false</claimable>
		</building>
	</ThingDef>

</Defs>
